# Domínio raiz (sem protocolo). Em dev: localhost:3000 → app.localhost:3000 e {slug}.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Supabase (em dev, pegue com `npx supabase status` depois de `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE no servidor. Nunca usar em código do navegador.
SUPABASE_SERVICE_ROLE_KEY=
# WhatsApp Cloud API (Meta). mock = só grava no banco e no log
WHATSAPP_MODE=mock                 # mock | live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=     # texto que você inventa e cola na Meta ao cadastrar o webhook
# "App secret" do app na Meta: valida a assinatura X-Hub-Signature-256 do webhook (obrigatório no modo live)
WHATSAPP_APP_SECRET=
# Gateway de pagamento (a definir em CAL-075)
BILLING_PROVIDER=                  # asaas | mercadopago | stripe (a definir)
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
# Segredo enviado pelo Vercel Cron no header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Login com Google no Supabase local (opcional; em produção configure no painel do Supabase)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Monitoramento de erros (opcional): URL de webhook (Slack, Discord…) que recebe cada erro do servidor/navegador
ERROR_WEBHOOK_URL=
